# =====================================================================================
# API KEYS TEMPLATE — Copy to .env and fill in your keys
# =====================================================================================
# Project variables are in engine_config.yaml (safe to commit)
# =====================================================================================

# FRED (Federal Reserve Economic Data)
# Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Finnhub
# Free tier: 60 calls/min | https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Financial Modeling Prep (FMP)
# Free: 250 calls/day | Starter $19/mo | https://site.financialmodelingprep.com
FMP_API_KEY=your_fmp_api_key_here

# SEC EDGAR — Free, requires User-Agent with contact email
SEC_EDGAR_USER_AGENT=YourName your.email@example.com

# Alpha Vantage (Optional — backup for technical indicators)
# Free: 25 calls/day | https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=placeholder_until_purchased

# Polygon.io (Optional — real-time/websocket data)
# Free: 5 calls/min | Starter $29/mo | https://polygon.io
POLYGON_API_KEY=placeholder_until_purchased

# SendGrid (V6 — email alerts for crash probability spikes)
SENDGRID_API_KEY=placeholder_until_purchased

# Twilio (V6 — SMS alerts)
TWILIO_ACCOUNT_SID=placeholder_until_purchased
TWILIO_AUTH_TOKEN=placeholder_until_purchased
TWILIO_PHONE_NUMBER=placeholder_until_purchased
