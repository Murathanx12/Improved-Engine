# FRED (Federal Reserve Economic Data)
# Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Finnhub
# Free tier: 60 calls/min
# https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Financial Modeling Prep (FMP)
# Free tier: 250 calls/day | Starter $19/mo: 10,000 calls/day
# https://site.financialmodelingprep.com/developer
FMP_API_KEY=your_fmp_api_key_here

# ── SUPPLEMENTARY DATA APIs (Free, No Key Required) ───────
SEC_EDGAR_USER_AGENT=YourName your.email@example.com

# ── OPTIONAL PAID APIs ────────────────────────

# Alpha Vantage (Optional backup for technical indicators)
# Free: 25 calls/day | Premium: $49.99/mo
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=placeholder_until_purchased

# Polygon.io (Optional for real-time/websocket data)
# Free: 5 calls/min | Starter $29/mo: unlimited
# https://polygon.io/dashboard/signup
POLYGON_API_KEY=placeholder_until_purchased

# ── V6 WEB PLATFORM APIs (Phase III) ──────────────────────

# SendGrid (Email alerts for crash probability spikes)
# Free: 100 emails/day | Essentials $19.95/mo
# https://sendgrid.com/
SENDGRID_API_KEY=placeholder_until_purchased

# Twilio (SMS alerts — optional)
# Pay-as-you-go: ~$0.0079/SMS
# https://www.twilio.com/
TWILIO_ACCOUNT_SID=placeholder_until_purchased
TWILIO_AUTH_TOKEN=placeholder_until_purchased
TWILIO_PHONE_NUMBER=placeholder_until_purchased

# ── APPLICATION CONFIG ─────────────────────────────────────

# Environment: development | staging | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Data cache settings
CACHE_DIR=data_cache
CACHE_TTL_HOURS=1

# Monte Carlo simulation defaults
MC_NUM_SIMULATIONS=10000
MC_PROJECTION_YEARS=5

# Database (Neon Postgres free tier or local SQLite for dev)
DATABASE_URL=sqlite:///./data_cache/finpredict.db

# Redis (Upstash free tier for task queue / caching)
REDIS_URL=placeholder_until_deployed

# JWT Secret (for user authentication in V6)
JWT_SECRET_KEY=placeholder_generate_with_openssl_rand_hex_32

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000