# =============================================================================
# API KEYS — Copy this file to .env and fill in your actual keys
# =============================================================================
#
# Steps:
#   1. Copy this file:    cp .env.example .env
#   2. Edit .env with your real API keys
#   3. Never commit .env — it is listed in .gitignore
#
# All engine parameters are in engine_config.yaml (safe to commit).
# This file is ONLY for API secrets.
# =============================================================================


# ── REQUIRED KEYS ────────────────────────────────────────────────────────────

# FRED (Federal Reserve Economic Data)
# Free — sign up at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Finnhub (market data, sentiment)
# Free tier: 60 API calls/min — sign up at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Financial Modeling Prep (analyst targets, financials)
# Free tier: 250 API calls/day — sign up at: https://site.financialmodelingprep.com
FMP_API_KEY=your_fmp_api_key_here


# ── OPTIONAL KEYS (not needed to run the engine) ────────────────────────────

# SEC EDGAR — Free, requires a User-Agent header with your name + email
SEC_EDGAR_USER_AGENT=YourName your.email@example.com

# Alpha Vantage (backup for technical indicators)
# Free: 25 calls/day — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=placeholder_until_purchased

# Polygon.io (real-time / websocket data)
# Free: 5 calls/min — https://polygon.io
POLYGON_API_KEY=placeholder_until_purchased

# SendGrid (email alerts for crash probability spikes — future feature)
SENDGRID_API_KEY=placeholder_until_purchased

# Twilio (SMS alerts — future feature)
TWILIO_ACCOUNT_SID=placeholder_until_purchased
TWILIO_AUTH_TOKEN=placeholder_until_purchased
TWILIO_PHONE_NUMBER=placeholder_until_purchased
